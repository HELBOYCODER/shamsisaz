<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- هدر: لوگو + امروز -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            android:backgroundTint="@color/primary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☀️"
                    android:textSize="40sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/subtitle"
                    android:textSize="13sp"
                    android:textColor="#C8E6C9"
                    android:layout_marginTop="4dp" />

                <View
                    android:layout_width="40dp"
                    android:layout_height="2dp"
                    android:background="#4CAF50"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvToday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="امروز: —"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="@drawable/bg_today_chip"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp" />

                <TextView
                    android:id="@+id/tvBrand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="گوشی: —"
                    android:textSize="11sp"
                    android:textColor="#A5D6A7"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="12sp"
                    android:textColor="#E8F5E9"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_stats_chip"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 👻 ارواح فارسی — فارسی‌ساز کامل کل گوشی با شیزوکو -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardShizuku"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/primary"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/cardHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👻 ارواح فارسی — فارسی‌ساز کامل کل گوشی"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvShizukuStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="در حال بررسی شیزوکو…"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:background="@drawable/bg_stats_chip"
                    android:padding="10dp"
                    android:layout_marginTop="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPersianize"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="👻 فارسی‌سازی کامل کل گوشی"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp"
                    app:cornerRadius="14dp"
                    style="@style/Widget.Material3.Button"
                    android:backgroundTint="@color/primary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShizukuInstall"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="📥 نصب"
                        android:textSize="11sp"
                        app:cornerRadius="10dp"
                        style="@style/Widget.Material3.Button.TonalButton" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShizukuStart"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="4dp"
                        android:text="🚀 روشن"
                        android:textSize="11sp"
                        app:cornerRadius="10dp"
                        style="@style/Widget.Material3.Button.TonalButton" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShizukuPerm"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="🔑 دسترسی"
                        android:textSize="11sp"
                        app:cornerRadius="10dp"
                        style="@style/Widget.Material3.Button.TonalButton" />
                </LinearLayout>

                <ScrollView
                    android:id="@+id/logScroll"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_stats_chip"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvShizukuLog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="11sp"
                        android:textColor="@color/text_primary"
                        android:padding="8dp"
                        android:visibility="gone" />
                </ScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- دکمهٔ جادویی — یک لمس -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMagic"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:text="@string/btn_magic"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_magic"
            app:iconSize="22dp"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/cardShizuku"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            style="@style/Widget.Material3.Button"
            android:backgroundTint="@color/primary" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/status_idle"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/btnMagic"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvStatus"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ردیف پیش‌نمایش + بازگردانی -->
        <LinearLayout
            android:id="@+id/rowActions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginTop="14dp"
            app:layout_constraintTop_toBottomOf="@id/progress"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPreview"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/btn_preview"
                android:textSize="13sp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:cornerRadius="12dp"
                app:strokeColor="@color/primary"
                android:textColor="@color/primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUndo"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/btn_undo"
                android:textSize="13sp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:cornerRadius="12dp"
                app:strokeColor="@color/text_secondary"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- کارت راهنمای تنظیمات سیستم — کل گوشی -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSystemHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="visible"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/rowActions"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙️ تبدیل کل گوشی از تنظیمات سیستم"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/system_locale_hint"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvSystemStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:background="@drawable/bg_stats_chip"
                    android:padding="10dp"
                    android:visibility="gone"
                    android:layout_marginTop="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSystemQuickFix"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="🇮🇷 تلاش سریع: فارسی‌سازی سیستمی (A336E)"
                    android:textSize="13sp"
                    android:layout_marginTop="10dp"
                    app:cornerRadius="12dp"
                    style="@style/Widget.Material3.Button"
                    android:backgroundTint="@color/primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSystemSettings"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/btn_open_system_settings"
                    android:textSize="13sp"
                    android:layout_marginTop="8dp"
                    app:cornerRadius="12dp"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:backgroundTint="@color/accent_light"
                    android:textColor="@color/primary_dark"
                    app:icon="@drawable/ic_settings"
                    app:iconSize="18dp" />

                
                <!-- پوشش سیستمی — تاریخ پیام‌ها -->
                <TextView
                    android:id="@+id/tvOverlayStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="پوشش خاموش — فعال کنید تا تاریخ\u200cهای پیام\u200cها شمسی شود"
                    android:textSize="11sp"
                    android:textColor="#6B7280"
                    android:background="@drawable/bg_stats_chip"
                    android:padding="10dp"
                    android:visibility="visible"
                    android:layout_marginTop="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="👁️ فعال\u200cسازی پوشش پیام\u200cها (اختیاری)"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp"
                    app:cornerRadius="12dp"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:backgroundTint="#FFF3E0"
                    android:textColor="#E65100"
                    app:icon="@drawable/ic_magic"
                    app:iconSize="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenCalendar"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="📅 باز کردن تقویم"
                    android:textSize="13sp"
                    android:layout_marginTop="8dp"
                    app:cornerRadius="12dp"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    app:strokeColor="@color/divider" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- فوتر -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="سامسونگ و شیائومی — اندروید ۷ به بالا\nساخت: شمسی‌ساز ۱٫۰ — آفلاین، بدون اینترنت"
            android:textSize="11sp"
            android:textColor="@color/text_hint"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintTop_toBottomOf="@id/cardSystemHint"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
